# Fake pre-1.92 b2-installed BoostConfig.cmake: Boost::headers plus a few compiled
# libraries; asking for any other component (e.g. a header-only one) fails, like real
# b2 configs before 1.92.
set(_fake_compiled random serialization unit_test_framework)
if(NOT TARGET Boost::headers)
  add_library(Boost::headers INTERFACE IMPORTED)
  get_filename_component(_fake_inc "${CMAKE_CURRENT_LIST_DIR}/../../../include" ABSOLUTE)
  set_target_properties(Boost::headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_fake_inc}")
endif()
if(NOT TARGET Boost::boost)
  add_library(Boost::boost INTERFACE IMPORTED)
  set_property(TARGET Boost::boost APPEND PROPERTY INTERFACE_LINK_LIBRARIES Boost::headers)
endif()
foreach(_c IN LISTS Boost_FIND_COMPONENTS)
  if(_c IN_LIST _fake_compiled)
    if(NOT TARGET Boost::${_c})
      add_library(Boost::${_c} INTERFACE IMPORTED)
      set_property(TARGET Boost::${_c} APPEND PROPERTY INTERFACE_LINK_LIBRARIES Boost::headers)
    endif()
    set(Boost_${_c}_FOUND TRUE)
  else()
    set(Boost_${_c}_FOUND FALSE)
    if(Boost_FIND_REQUIRED_${_c})
      set(Boost_FOUND FALSE)
      set(Boost_NOT_FOUND_MESSAGE "Failed to find required component ${_c}")
    endif()
  endif()
endforeach()
